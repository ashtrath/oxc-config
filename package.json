{
  "name": "oxc-config-monorepo",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashtrat/oxc-config.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalogs": {
      "dev": {
        "@types/node": "^24.0.0",
        "publint": "^0.3.25",
        "tinyexec": "^1.3.1",
        "tinyglobby": "^0.2.17",
        "tsdown": "^0.23.0",
        "tsdown-stale-guard": "^0.1.3",
        "tsnapi": "^1.5.0",
        "turbo": "^2.11.7",
        "typescript": "^7",
        "vitest": "^5.0.3"
      },
      "peer": {
        "@ashtrath/oxlint-plugin-slop": "workspace:^*",
        "eslint-plugin-sonarjs": "^4.2.2",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "oxlint-plugin-react-doctor": "^0.9.17",
        "oxlint-tailwindcss": "^1.14.0",
        "oxlint-tsgolint": "^7.0.2003"
      },
      "prod": {
        "@antfu/install-pkg": "^2.1.0",
        "@clack/prompts": "^1.8.1",
        "@e18e/eslint-plugin": "^0.8.1",
        "@oxlint/plugins": "^1.87.0",
        "ansis": "^4.4.0",
        "citty": "^0.2.2",
        "defu": "^6.1.7",
        "eslint-plugin-antfu": "^3.2.3",
        "eslint-plugin-command": "^4.0.0",
        "eslint-plugin-perfectionist": "^5.12.1",
        "eslint-plugin-regexp": "^3.3.1",
        "local-pkg": "^1.2.1",
        "oxlint-plugin-directive-comments": "^0.1.0"
      }
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "fmt": "oxfmt --write --no-error-on-unmatched-pattern",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@ashtrath/oxc-config": "workspace:*",
    "@types/node": "catalog:dev",
    "oxfmt": "catalog:peer",
    "oxlint": "catalog:peer",
    "oxlint-tsgolint": "catalog:peer",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.4.0"
    }
  }
}
