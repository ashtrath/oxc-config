{
  "arrowParens": "avoid",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "jsxSingleQuote": false,
  "printWidth": 100,
  "quoteProps": "as-needed",
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "sortImports": false,
  "sortPackageJson": false,
  "sortTailwindcss": false,
  "jsdoc": false,
  "ignorePatterns": [
    "**/node_modules",
    "**/bun.lock",
    "**/bun.lockb",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/.yarn",
    "**/_astro",
    "**/android/build",
    "**/build",
    "**/DerivedData/**/*",
    "**/dist",
    "**/ios/build",
    "**/out",
    "**/output",
    "**/.astro",
    "**/.cache",
    "**/.changeset",
    "**/.expo",
    "**/.expo-shared",
    "**/.history",
    "**/.idea",
    "**/.netifly",
    "**/.next",
    "**/.nuxt",
    "**/.nyc_output",
    "**/.open-next",
    "**/.output",
    "**/.parcel-cache",
    "**/.svelte-kit",
    "**/temp",
    "**/.temp",
    "**/tmp",
    "**/.tmp",
    "**/.turbo",
    "**/.vercel",
    "**/.vite",
    "**/.vitepress/cache",
    "**/__snapshots__",
    "**/coverage",
    "**/.agents",
    "**/.claude",
    "**/.context",
    "**/.*/skills",
    "**/__generated__",
    "**/_generated",
    "**/auto-generated",
    "**/codegen",
    "**/generated",
    "**/graphql-types.*",
    "**/next-env.d.ts",
    "**/schema.d.ts",
    "**/schema.graphql.d.ts",
    "**/worker-configuration.d.ts",
    "**/*.auto.*",
    "**/*.d.ts.map",
    "**/*.gen.*",
    "**/*.generated.*",
    "**/CHANGELOG*.md",
    "**/LICENSE*",
    "**/*.min.*"
  ],
  "overrides": []
}