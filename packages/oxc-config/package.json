{
  "name": "@ashtrath/oxc-config",
  "version": "0.1.0",
  "description": "Ashtrath's OXC (oxlint + oxfmt) config",
  "keywords": [
    "oxc",
    "oxc-config",
    "oxfmt",
    "oxlint"
  ],
  "homepage": "https://github.com/ashtrath/oxc-config",
  "bugs": {
    "url": "https://github.com/ashtrath/oxc-config/issues"
  },
  "license": "MIT",
  "author": "Rahadian Fahri Faizani <ashtrath@pm.me> (https://github.com/ashtrath)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashtrath/oxc-config.git",
    "directory": "packages/oxc-config"
  },
  "bin": "./bin/index.mjs",
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "exports": {
    "./cli": "./dist/cli/index.mjs",
    "./fmt": "./dist/fmt/index.mjs",
    "./lint": "./dist/lint/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun gen && tsdown",
    "dev": "tsdown --watch",
    "gen": "bun ./scripts/versiongen.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@antfu/install-pkg": "catalog:prod",
    "@clack/prompts": "catalog:prod",
    "@e18e/eslint-plugin": "catalog:prod",
    "ansis": "catalog:prod",
    "citty": "catalog:prod",
    "defu": "catalog:prod",
    "eslint-plugin-antfu": "catalog:prod",
    "eslint-plugin-command": "catalog:prod",
    "eslint-plugin-perfectionist": "catalog:prod",
    "eslint-plugin-regexp": "catalog:prod",
    "local-pkg": "catalog:prod",
    "oxlint-plugin-directive-comments": "catalog:prod"
  },
  "devDependencies": {
    "@ashtrath/oxlint-plugin-slop": "catalog:peer",
    "@types/node": "catalog:dev",
    "eslint-plugin-sonarjs": "catalog:peer",
    "oxlint-plugin-react-doctor": "catalog:peer",
    "oxlint-tailwindcss": "catalog:peer",
    "publint": "catalog:dev",
    "tinyexec": "catalog:dev",
    "tinyglobby": "catalog:dev",
    "tsdown": "catalog:dev",
    "tsdown-stale-guard": "catalog:dev",
    "tsnapi": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "peerDependencies": {
    "@ashtrath/oxlint-plugin-slop": "workspace:^",
    "eslint-plugin-sonarjs": "^4.2.2",
    "oxfmt": ">=0.67.0",
    "oxlint": ">=1.43.0 <1.77.0 || >=1.78.0",
    "oxlint-plugin-react-doctor": "^0.9.17",
    "oxlint-tailwindcss": "^1.14.0",
    "oxlint-tsgolint": ">=7.0.2003"
  },
  "peerDependenciesMeta": {
    "@ashtrath/oxlint-plugin-slop": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "oxlint-plugin-react-doctor": {
      "optional": true
    },
    "oxlint-tailwindcss": {
      "optional": true
    }
  }
}
