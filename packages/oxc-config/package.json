{
  "name": "@ashtrath/oxc-config",
  "version": "0.0.0",
  "description": "Ashtrath's OXC (oxlint + oxfmt) config",
  "keywords": [
    "oxc",
    "oxc-config",
    "oxfmt",
    "oxlint"
  ],
  "homepage": "https://github.com/ashtrath/oxc-config",
  "bugs": {
    "url": "https://github.com/ashtrath/oxc-config/issues"
  },
  "license": "MIT",
  "author": "Rahadian Fahri Faizani <ashtrath@pm.me> (https://github.com/ashtrath)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashtrath/oxc-config.git",
    "directory": "packages/oxc-config"
  },
  "bin": "./bin/index.mjs",
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ashtrath/oxlint-plugin-slop": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev",
    "tsdown-stale-guard": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "peerDependencies": {
    "oxfmt": ">=0.72.0",
    "oxlint": ">=1.87.0",
    "oxlint-tsgolint": ">=7.0.2003"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  }
}
